[TEMPLATE]
# Ключи платных API не нужны: карточки организаций открывает ваш браузер на
# странице Яндекс.Карт. Вписывать сюда что-либо не обязательно.

# HTTP port. По умолчанию: 5000 (Windows), 5050 (macOS). Меняйте, если занят.
# YP_PORT = "5000"

# Токен ВКонтакте (необязательно) — только фильтр «Проверять активность
# ВКонтакте» на этапе 2: нужно право читать данные сообществ (wall, groups).
# Без токена шаг пропускается с предупреждением, всё остальное работает.
# VK_TOKEN = "your_vk_access_token"

# Токен GitHub (необязательно) — только кнопка «Создать issue» в окне
# «Сообщить о проблеме»: GitHub API не создаёт issue анонимно. Нужны права
# на запись issues (fine-grained: Issues write; classic: public_repo).
# Вручную его вводить не требуется: окно умеет входить по коду (device
# flow) и записывает полученный токен сюда само. Задавать значение здесь
# нужно только для готового токена или если вход по коду не настроен.
# GITHUB_TOKEN = "github_pat_..."

# client_id OAuth-приложения GitHub — только переопределение при разработке.
# В релизную сборку он зашит (routes/diagnostics.py,
# GH_DEVICE_CLIENT_ID_DEFAULT), поэтому пользователю НИЧЕГО создавать не
# нужно: он лишь вводит короткий код на github.com/login/device. Само
# OAuth-приложение заводит владелец репозитория один раз (GitHub →
# Settings → Developer settings → OAuth Apps → New OAuth App; callback
# и секрет для device flow не нужны, на странице приложения включается
# опция Enable Device Flow). Если client_id не задан нигде,
# кнопка «Войти в GitHub» не показывается — остаётся заполненная форма.
# GITHUB_OAUTH_CLIENT_ID = "Iv1.abcd1234efgh5678"
