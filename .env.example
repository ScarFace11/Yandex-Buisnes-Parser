[TEMPLATE]
# Yandex Maps API key
# Get yours at: https://developer.tech.yandex.ru/
# NEVER commit a real key to Git.
YANDEX_API_KEY="your_yandex_api_key_here"
TWOGIS_API_KEY = "your_key"

# HTTP port. По умолчанию: 5000 (Windows), 5050 (macOS). Меняйте, если занят.
# YP_PORT = "5000"

# VK user token (optional) — only for the «Проверять активность ВКонтакте»
# stage-2 filter and the bulk sender. Needs the wall, groups, offline scopes.
# Without it the activity step is skipped with a warning; everything else works.
# VK_TOKEN = "your_vk_access_token"
